# macOS / editor cruft (anywhere in the tree)
**/.DS_Store
.DS_Store
*.~undo-tree~

# Python
*.pyc
__pycache__/
**/__pycache__/
*.egg-info/

# Build and distribution artefacts
dist/
build/

# Auto-generated model artefacts (counterterm tensors, etc.)
models/generated/

# IDE
.vscode/settings.json
**/.vscode/settings.json

# tl runtime outputs (anywhere in the tree)
scans/
**/scans/
output.*.txt

# Sphinx / docs build artifacts
docs/_build/
docs/build/
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.bbl
docs/*.blg
docs/*.fls
docs/*.fdb_latexmk

# arxiv LaTeX build artifacts (we ship the figure PDFs but never the LaTeX
# intermediates of main.tex)
arxiv/*.aux
arxiv/*.bbl
arxiv/*.bcf
arxiv/*.blg
arxiv/*.fdb_latexmk
arxiv/*.fls
arxiv/*.log
arxiv/*.out
arxiv/*.run.xml
arxiv/*.synctex.gz
arxiv/*.toc
arxiv/main.pdf

# Slurm logs and submit scripts (working-tree only; never tracked)
*.sbatch
slurm_logs/
**/slurm_logs/

# tl/tests scratch outputs that were getting noisy
tests/results/
diffs/

# Sub-paper / dev-only sandboxes that occasionally re-appear in the tree
# (these directories are not tracked on the release branch)
to_be_deleted/
debug_outputs/
SMEWPHT/
THDM_EWPT/
ptamodels_plots/
tools/
BSMPT/

# Top-level submit shell scripts. We never ship these; researcher-side
# submission scripts belong in the local sandbox or in tests/.
submit_*.sh

# PNG copies of the figures, written only for on-screen inspection; every note
# embeds the .pdf version.
# numerical caches written by the note scripts (delete to force recomputation)

# large Monte Carlo outputs of the transport study (reproducible with mc_transport.py)
# local backups of superseded analysis outputs
paper/analysis/*_before_*.npz

# job logs and numba caches of the paper and note scripts
paper/**/*.err
paper/**/*.out
paper/**/*.log
*.nbi
*.nbc
# Local test-suite and batch-job logs
suite_logs/
